DATABASE_URL="postgresql://cms:cms_password@localhost:5432/cms_db"
JWT_SECRET="dev_jwt_secret_please_change_in_production_32chars"
JWT_REFRESH_SECRET="dev_refresh_secret_please_change_in_production_32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000"
REVALIDATION_SECRET="dev_revalidation_secret"
REVALIDATION_URL="http://localhost:3000/api/revalidate"
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DEST="./uploads"

# Messaging — Zalo OA (leave empty to disable)
ZALO_OA_ID=""
ZALO_OA_SECRET=""
ZALO_OA_REFRESH_TOKEN=""
ZALO_API_URL="https://openapi.zalo.me/v2.0"

# Messaging — Facebook (leave empty to disable)
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_APP_SECRET=""
FACEBOOK_GRAPH_API_VERSION="v21.0"

# Messaging — general
MESSAGING_BATCH_SIZE=20
MESSAGING_RATE_LIMIT_MS=200

# Email — SMTP for trial registration notifications (leave empty to disable)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Frontend base URL — used to build absolute media URLs
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
