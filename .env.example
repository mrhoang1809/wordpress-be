# Database
DATABASE_URL="postgresql://cms:cms_password@localhost:5432/cms_db"

# JWT — replace with strong random secrets in production
JWT_SECRET="replace_with_strong_random_secret_min_32_chars"
JWT_REFRESH_SECRET="replace_with_another_strong_secret_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV="development"

# CORS — comma-separated origins
ALLOWED_ORIGINS="http://localhost:3000"

# Cache revalidation
REVALIDATION_SECRET="replace_with_revalidation_secret"
REVALIDATION_URL="http://localhost:3000/api/revalidate"

# Media upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DEST="./uploads"

# Messaging — Zalo OA
ZALO_OA_ID=""
ZALO_OA_SECRET=""
ZALO_OA_REFRESH_TOKEN=""
ZALO_API_URL="https://openapi.zalo.me/v2.0"

# Messaging — Facebook
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_APP_SECRET=""
FACEBOOK_GRAPH_API_VERSION="v21.0"

# Messaging — general
MESSAGING_BATCH_SIZE=20
MESSAGING_RATE_LIMIT_MS=200

# Email — SMTP for trial registration notifications
# Leave SMTP_HOST empty to disable email sending
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
